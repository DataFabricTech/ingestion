{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "IngestionCheck",
  "$comment": "@om-entity-type",
  "description": "This schema defines the Ingestion entity.",
  "type": "object",
  "definitions": {
    "IngestionStatus": {
      "type": "object",
      "description": "This schema defines the type for Ingeestion Status config.",
      "properties": {
        "system_id": {
          "description": "system_id",
          "type": "string"
        },
        "status": {
          "description": "수집 상태",
          "type": "string"
        },
        "err_description": {
          "description": "에러 내용",
          "type": "string"
        },
        "user": {
          "description": "api 호출자",
          "type": "string"
        }
      },
      "required": ["system_id", "status"]
    },
    "MetadataSystemInfo": {
      "type": "object",
      "description": "This schema is MetadataSystemInfo",
      "properties": {
        "system_id": {
          "description": "system_id",
          "type": "string"
        },
        "system_type": {
          "description": "system_type",
          "type": "string"
        },
        "host": {
          "description": "host",
          "type": "string"
        },
        "port": {
          "description": "port",
          "type": "integer"
        },
        "login": {
          "description": "login",
          "type": "string"
        },
        "password": {
          "description": "password",
          "type": "string"
        },
        "database": {
          "description": "database",
          "type": "string"
        },
        "filter_config": {
          "description": "filter_config",
          "type": "string"
        }
      },
      "required": ["system_id", "system_type", "host", "port", "login", "password", "database"]
    },
    "ProfileType" : {
      "description": "정형 데이터 프로파일 타입",
      "type" : "string",
      "enum": [
        "table",
        "column"
      ]
    },
    "ExecuteIngestion": {
      "type": "object",
      "description": "This schema defines the type for Execute Ingestion config.",
      "properties": {
        "system_id": {
          "description": "system_id",
          "type": "string"
        },
        "profile_type": {
          "$ref": "#/definitions/ProfileType"
        },
        "include": {
          "description": "수집 필터 (제외 항목), 예: ['database=aaa'] or ['database=aaa,bbb', 'schema=sss'], 필터 키: database, schema, table, bucket, object",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "exclude": {
          "description": "수집 필터 (제외 항목), 예: ['database=aaa'] or ['database=aaa,bbb', 'schema=sss'], 필터 키: database, schema, table, bucket, object",
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "required": ["system_id"]
    }
  },
  "properties": {
    "system_id": {
      "description": "ingestion system name",
      "type": "string"
    }
  },
  "required": ["system_id"],
  "additionalProperties": false
}
