{
  "title": "TiberoConnection",
  "description": "Tibero Database Connection Config",
  "type": "object",
  "definitions": {
    "tiberoType": {
      "description": "Service type.",
      "type": "string",
      "enum": [
        "Tibero"
      ],
      "default": "Tibero"
    },
    "tiberoScheme": {
      "description": "SQLAlchemy driver scheme options.",
      "type": "string",
      "enum": [
        "tibero+pyodbc"
      ],
      "default": "tibero+pyodbc"
    }
  },
  "properties": {
    "scheme": {
      "title": "Connection Scheme",
      "description": "SQLAlchemy driver scheme options.",
      "$ref": "#/definitions/tiberoScheme",
      "default": "tibero+pyodbc"
    },
    "username": {
      "title": "Username",
      "description": "Username to connect to Tibero. This user should have privileges to read all the metadata in Tibero.",
      "type": "string"
    },
    "password": {
      "title": "Password",
      "description": "Password to connect to Tibero.",
      "type": "string",
      "format": "password"
    },
    "odbcDsnName": {
      "title": "ODBC DSN Name",
      "type": "string"
    },
    "connectionArguments": {
      "title": "Connection Arguments",
      "$ref": "../connectionBasicType.json#/definitions/connectionArguments"
    },
    "supportsMetadataExtraction": {
      "title": "Supports Metadata Extraction",
      "$ref": "../connectionBasicType.json#/definitions/supportsMetadataExtraction"
    },
    "supportsDBTExtraction": {
      "$ref": "../connectionBasicType.json#/definitions/supportsDBTExtraction"
    },
    "supportsProfiler": {
      "title": "Supports Profiler",
      "$ref": "../connectionBasicType.json#/definitions/supportsProfiler"
    }
  },
  "additionalProperties": false,
  "required": [
    "schema",
    "username"
  ]
}
